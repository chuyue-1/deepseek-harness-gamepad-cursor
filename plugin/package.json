{
  "name": "@dsh-user/gamepad-cursor",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Gamepad-controlled virtual cursor for DSH Web: circle-dot default, animated sprite styles, mouse-compatible clicks and hover.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "gamepad",
    "cursor"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "styles.json",
    "cordis.patch.yml",
    "dict-pinyin.json",
    "assets",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
